{
  "name": "zagrev/user-import",
  "description": "Import WordPress users from a CSV file.",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.4",
    "yahnis-elsts/plugin-update-checker": "^5.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0",
    "squizlabs/php_codesniffer": "3.13.6",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "config": {
    "vendor-dir": "vendor",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "php -l user-import.php && php -l uninstall.php && php -l tests/UserImportTest.php",
    "test": "phpunit"
  }
}
